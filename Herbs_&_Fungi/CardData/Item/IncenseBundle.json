    "CardDescription": {
        "ParentObjectID": "herbs_fungi_incense_bundle",
        "LocalizationKey": "Herbs_And_Fungi_IncenseBundle_CardDescription",
        "DefaultText": "Dried wild flowers, chamomile and yarrow bound tight with twine. Touch a flame to one end and it smoulders rather than burns, scenting the whole room until it is gone."
    },
    "CardHelpSection": {
        "ParentObjectID": "herbs_fungi_incense_bundle",
        "LocalizationKey": "Herbs_And_Fungi_IncenseBundle_CardHelpSection",
        "DefaultText": "<b>Lighting:</b> Drag a fire or a lit torch onto the bundle.\n\n<b>Burn time:</b> 12 units, about three hours, then it is used up.\n\n<b>While lit:</b> Eases stress and makes the room feel more sheltered. It works from anywhere on your board, not only in your hands. It is consumed, not reusable."
    },
