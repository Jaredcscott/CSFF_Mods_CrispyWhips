    },
    "CardDescription": {
        "ParentObjectID": "herbs_fungi_unknown_chanterelle",
        "LocalizationKey": "Herbs_And_Fungi_UnknownChanterelle_CardDescription",
        "DefaultText": "A golden, funnel-shaped mushroom that might be a Chanterelle, or might be its look-alike, the False Chanterelle. Identify it before you eat it."
    },
    "CardHelpSection": {
        "ParentObjectID": "herbs_fungi_unknown_chanterelle",
        "LocalizationKey": "Herbs_And_Fungi_UnknownChanterelle_CardHelpSection",
        "DefaultText": "<b>Found by:</b> foraging wherever Chanterelles grow; about one find in four is an Unknown Chanterelle.\n\n<b>Uses:</b> Identify it to learn what it is: with Herbalism skill 25 or more, by dragging a Botanical Field Guide onto it (the guide is not used up), or, with Community Mod Chest installed, once you have graduated the Academy's Herbalism course. It turns into a Chanterelle or a False Chanterelle. Eating it unidentified gives food poisoning."
    },
