    "CardDescription": {
        "ParentObjectID": "herbs_fungi_oats",
        "LocalizationKey": "herbsfungioats_CardDescription",
        "DefaultText": "A handful of oat grains in their husks. Chewable raw, better ground into oatmeal for porridge, and good animal feed."
    },
    "CardHelpSection": {
        "ParentObjectID": "herbs_fungi_oats",
        "LocalizationKey": "herbsfungioats_CardHelpSection",
        "DefaultText": "<b>Found:</b> Foraging in summer and autumn at Pine Meadows and the Secret Grove.\n\n<b>Uses:</b> Eat raw. Grind with a stone mortar, a grinding tool or a Grinding Mill into Oatmeal. Livestock feed. Holding them unlocks the Oat Field."
    },
