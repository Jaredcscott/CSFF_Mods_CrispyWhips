    "CardDescription": {
        "ParentObjectID": "herbs_fungi_roasted_peanuts",
        "LocalizationKey": "Herbs_And_Fungi_RoastedPeanuts_CardDescription",
        "DefaultText": "Warm, fragrant peanuts roasted over a fire. Packed with fat and protein — a dense, satisfying meal, though you'll want water nearby."
    },
    "CardHelpSection": {
        "ParentObjectID": "herbs_fungi_roasted_peanuts",
        "LocalizationKey": "Herbs_And_Fungi_RoastedPeanuts_CardHelpSection",
        "DefaultText": "<b>Made from:</b> Raw Peanuts left in a lit fire for about 15 minutes. Take them out within a few hours, or they char.\n\n<b>Uses:</b> Eat for a substantial fat and protein boost. High in calories, but very drying — have water on hand. Keeps for over a month.\n\n<b>Grind:</b> Grind with any grinding tool into Peanut Butter.\n\n<b>Cooking tab:</b> Trail Mix (with dried billberries), Honeyed Nuts (with honeycomb) and Peanut Meal, which soaks into Nut Milk."
    },
