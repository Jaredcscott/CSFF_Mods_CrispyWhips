{
    "UniqueID": "herbs_fungi_death_cap_dried",
    "CardName": {
        "ParentObjectID": "herbs_fungi_death_cap_dried",
        "LocalizationKey": "Herbs_And_Fungi_DeathCapDried_CardName",
        "DefaultText": "Dried Death Cap"
    },
    "CardDescription": {
        "ParentObjectID": "herbs_fungi_death_cap_dried",
        "LocalizationKey": "Herbs_And_Fungi_DeathCapDried_CardDescription",
        "DefaultText": "A death cap dried hard and light, still deadly. Folk herbalists claim that a sliver no bigger than a grain of rice, taken with great care, teaches the body to withstand the next poisoning. It is never safe."
    },
    "CanBeRenamed": false,
    "CardHelpSection": {
        "ParentObjectID": "herbs_fungi_death_cap_dried",
        "LocalizationKey": "Herbs_And_Fungi_DeathCapDried_CardHelpSection",
        "DefaultText": "<b>Use:</b> Taste a Sliver gives a short bout of mild food poisoning (+4, below the Death Cap Tincture's +15) and builds Toxin Tolerance, which makes later food poisoning fade faster while it lasts. Each sliver uses up the dried cap.\n\n<b>Warning:</b> Do not eat a death cap whole. The dose and the length of the tolerance are starting values, not tuned."
    },
