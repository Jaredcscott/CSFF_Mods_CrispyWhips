    "DefaultText": "Iron Shield"
  },
  "CardDescription": {
    "ParentObjectID": "act_iron_shield",
    "LocalizationKey": "Advanced_Copper_Tools_IronShield_CardDescription",
    "DefaultText": "A wooden shield faced with forged iron sheet and a raised iron boss. Held in hand like the wooden Shield, it guards the shield arm with 95 armor, 145 against spiritual attacks, the best block of any shield. Can be recycled in a furnace."
  },
  "CardHelpSection": {
    "ParentObjectID": "act_iron_shield",
    "LocalizationKey": "Advanced_Copper_Tools_IronShield_CardHelpSection",
    "DefaultText": "<b>Crafted:</b> From 3 iron sheets, 1 plank, 4 metal nails and 1 medium leather using a hammer.\n\n<b>Uses:</b> Equip it to hold it in hand. It draws blows toward your shield arm and covers that arm with 95 armor, 145 against spiritual attacks. It wears down slowly while equipped."
  },
