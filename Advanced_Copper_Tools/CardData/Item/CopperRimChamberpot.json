  "CardDescription": {
    "ParentObjectID": "advanced_copper_tools_copper_rim_chamberpot",
    "LocalizationKey": "Advanced_Copper_Tools_CopperRimChamberpot_CardDescription",
    "DefaultText": "A clay chamberpot with a hammered copper rim. Relieve yourself in it instead of a cold trip outside. Holds four uses before it needs emptying."
  },
