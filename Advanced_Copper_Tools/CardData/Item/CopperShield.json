{
  "UniqueID": "act_copper_shield",
  "CardName": {
    "ParentObjectID": "act_copper_shield",
    "LocalizationKey": "Advanced_Copper_Tools_CopperShield_CardName",
    "DefaultText": "Metal Shield"
  },
  "CardDescription": {
    "ParentObjectID": "act_copper_shield",
    "LocalizationKey": "Advanced_Copper_Tools_CopperShield_CardDescription",
    "DefaultText": "A wooden shield faced with metal sheet. Its protection, weight and look follow the metal it was made from. Can be recycled in a furnace."
  },
  "CardHelpSection": {
    "ParentObjectID": "act_copper_shield",
    "LocalizationKey": "Advanced_Copper_Tools_CopperShield_CardHelpSection",
    "DefaultText": "<b>Crafted:</b> From 3 metal sheets of one metal, 1 plank, 4 metal nails and 1 medium leather using a hammer. The shield takes the metal of its sheets.\n\n<b>Uses:</b> Equip it to hold it in hand. It draws blows toward your shield arm and covers that arm with armor that follows its metal: copper 80 (130 against spiritual attacks), tin 82.5 (132.5), ghost bronze 85 (165), tin bronze 87.5 (137.5), white bronze 92.5 (142.5), iron 95 (145). It wears down slowly while equipped, and an iron shield rusts while you are wet unless it has an Oil Coat."
  },
