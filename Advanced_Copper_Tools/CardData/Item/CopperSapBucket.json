{
  "UniqueID": "act_copper_sap_bucket",
  "CardName": {
    "ParentObjectID": "act_copper_sap_bucket",
    "LocalizationKey": "Advanced_Copper_Tools_CopperSapBucket_CardName",
    "DefaultText": "Copper Sap Bucket"
  },
  "CardDescription": {
    "ParentObjectID": "act_copper_sap_bucket",
    "LocalizationKey": "Advanced_Copper_Tools_CopperSapBucket_CardDescription",
    "DefaultText": "A small copper bucket with a wire bail, made to hang under a tap. Put it in a Sap Tap and it catches the sap: it holds 900, a whole flow from a spigot tap. Put it in a Resin Tap (Spigot) and it gathers up to four lumps of resin, one every 18 hours."
  },
  "CanBeRenamed": false,
  "LiquidSuffixName": {
    "ParentObjectID": "act_copper_sap_bucket",
    "LocalizationKey": "",
    "DefaultText": ""
  },
  "CardHelpSection": {
    "ParentObjectID": "act_copper_sap_bucket",
    "LocalizationKey": "Advanced_Copper_Tools_CopperSapBucket_CardHelpSection",
    "DefaultText": "<b>Sap:</b> Place the bucket in a Sap Tap (plain or with a Copper Spigot). The tap pours its sap into it. It holds 900, the whole three-day flow of a spigot tap.\n\n<b>Resin:</b> Place the bucket in a Resin Tap (Spigot). A lump of resin gathers in it every 18 hours while the resin flows, up to four. Use Scrape Out Resin to take them out one at a time. A plain Resin Tap does not fill the bucket.\n\n<b>Crafted:</b> 2 metal sheets, 1 tin solder and a hammer."
  },
