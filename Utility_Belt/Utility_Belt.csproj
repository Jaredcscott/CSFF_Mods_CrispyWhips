<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>Utility_Belt</RootNamespace>
        <AssemblyName>Utility_Belt</AssemblyName>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <TargetFramework>net48</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DebugType>none</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>C:\Program Files (x86)\Steam\steamapps\common\Card Survival Fantasy Forest\BepInEx\plugins\Utility_Belt\</OutputPath>
    </PropertyGroup>

    <!-- Pure C# utility mod: no CardData. Localization/ carries the bundled modules' own overlay rows
         (Quick Transfer's), copied byte for byte (UtilityBelt-Bundle check f). Each folder a later phase
         adds (Resource) arrives with its own Include in the same commit: Development_Tools/Tests/Csproj-ContentIncludes.Tests.ps1 fails on a folder with none. -->
    <ItemGroup>
        <Content Include="ModInfo.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ModInfo.json')" />
        <Content Include="Localization\**\*.csv" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Localization')" />
        <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" Condition="Exists('LICENSE')" />
        <Content Include="ASSET_CREDITS.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ASSET_CREDITS.md')" />
    </ItemGroup>

    <!-- Reference DLLs bind the framework's own lib, the copy refreshed from the game on every update
         (new-mod Step 7). The Harmony patches (Patcher/) bind 0Harmony and the canonical
         Assembly-CSharp (never an nstrip copy); no CSFFModFramework reference, UB takes no framework dependency.
         No DLL lives in this folder, so MSBuild's candidate-file search cannot shadow a HintPath. -->
    <ItemGroup>
        <Reference Include="BepInEx">
            <HintPath>..\CSFFModFramework\lib\BepInEx.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>..\CSFFModFramework\lib\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>..\CSFFModFramework\lib\Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine" HintPath="..\CSFFModFramework\lib\UnityEngine.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule" HintPath="..\CSFFModFramework\lib\UnityEngine.CoreModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule" HintPath="..\CSFFModFramework\lib\UnityEngine.InputLegacyModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.UI" HintPath="..\CSFFModFramework\lib\UnityEngine.UI.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro" HintPath="..\CSFFModFramework\lib\Unity.TextMeshPro.dll">
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <!-- Bundled modules (plan 1.2 option 2b): each module builds from its own csproj in Release (never its
         Debug OutputPath, which is the live game) and its DLL is copied beside Utility_Belt.dll. A file copy,
         never a ProjectReference: MSBuild would copy the module's ModInfo.json over this mod's.
         Development_Tools/Tests/UtilityBelt-Bundle.Tests.ps1 keeps this list, ModuleRegistry.cs and the
         Deploy-Mods.ps1 block naming the same DLLs. -->
    <Target Name="BuildBundledModules" BeforeTargets="BeforeBuild">
        <MSBuild Projects="..\RepeatAction\Repeat_Action.csproj" Properties="Configuration=Release" Targets="Build" />
        <MSBuild Projects="..\QuickTransfer\Quick_Transfer.csproj" Properties="Configuration=Release" Targets="Build" />
        <MSBuild Projects="..\SkillSpeedBoost\Skill_Speed_Boost.csproj" Properties="Configuration=Release" Targets="Build" />
    </Target>
    <Target Name="CopyBundledModules" AfterTargets="Build">
        <Copy SourceFiles="..\RepeatAction\bin\Release\Repeat_Action.dll" DestinationFolder="$(OutDir)" />
        <Copy SourceFiles="..\QuickTransfer\bin\Release\Quick_Transfer.dll" DestinationFolder="$(OutDir)" />
        <Copy SourceFiles="..\SkillSpeedBoost\bin\Release\Skill_Speed_Boost.dll" DestinationFolder="$(OutDir)" />
    </Target>
</Project>
