        "LocalizationKey": "CMC_StockpileTwigs_CardName",
        "DefaultText": "Twig Stockpile"
    },
    "CardDescription": {
        "ParentObjectID": "cmcStockpileTwigs",
        "LocalizationKey": "CMC_StockpileTwigs_CardDescription",
        "DefaultText": "A heap of Twigs on a patch of bare earth, kept as one tidy count. Drag Twigs onto it to store them, up to 50 (hold to drag a whole stack); Take One or Take Five hands them back."
    },
    "CardHelpSection": {
        "ParentObjectID": "cmcStockpileTwigs",
        "LocalizationKey": "CMC_StockpileTwigs_CardHelpSection",
        "DefaultText": "<b>Fullness:</b> how many Twigs are stored, out of 50. <b>Stack the Twigs:</b> Drag a Twig onto the heap to store it; a full heap refuses and keeps the Twig in your hand. <b>Take One, Take Five:</b> Hands back that many Twigs, or whatever is left. <b>Take Apart:</b> Hands back every stored Twig and two Planks."
    },
