{
    "UniqueID": "cmcDyeVat",
    "SpillsInventoryOnDestroy": true,
    "CardName": {
        "ParentObjectID": "cmcDyeVat",
        "LocalizationKey": "CMC_DyeVat_CardName",
        "DefaultText": "Dye Vat"
    },
    "CardDescription": {
        "ParentObjectID": "cmcDyeVat",
        "LocalizationKey": "CMC_DyeVat_CardDescription",
        "DefaultText": "A wide wooden vat for dyeing cloth by the armful. Put plain garments and pigments inside, then choose a colour: every plain garment in the vat is dyed, one pigment each, and keeps its wear. A garment that already carries a dye is left alone."
    },
    "CardHelpSection": {
        "ParentObjectID": "cmcDyeVat",
        "LocalizationKey": "CMC_DyeVat_CardHelpSection",
        "DefaultText": "<b>Dye Charcoal, Dye Ochre, Dye Billberry:</b> Dyes every plain Cloth Scarf, Cloth Coat, Cloth Mask, Chaperon, Quilted Cap, Straw Hat and Leather Apron in the vat, using one matching pigment for each. When the pigment runs out, the rest stay plain. <b>Take Apart:</b> Splits the vat back into Planks and Rope; whatever is inside spills out."
    },
