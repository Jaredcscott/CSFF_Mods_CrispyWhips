    "CardName": {
        "ParentObjectID": "cmcOutfitWardrobe",
        "LocalizationKey": "CMC_OutfitWardrobe_Placed_CardName",
        "DefaultText": "Outfit Wardrobe"
    },
    "CardDescription": {
        "ParentObjectID": "cmcOutfitWardrobe",
        "LocalizationKey": "CMC_OutfitWardrobe_Placed_CardDescription",
        "DefaultText": "A tall wardrobe built with three separate hanging sections, each one big enough for a full outfit — store three complete sets of gear and step into any of them in a moment."
    },
    "CardHelpSection": {
        "ParentObjectID": "cmcOutfitWardrobe",
        "LocalizationKey": "CMC_OutfitWardrobe_Placed_CardHelpSection",
        "DefaultText": "<b>Usage:</b> The wardrobe's storage is split into three 18-slot sections, one per outfit, each labeled right on the grid ('Outfit 1/2/3') so you can see where to drop things. Drag equippable gear into a section, then use that section's Equip button to put on everything hanging there in one motion — clicking Equip or Unequip also scrolls straight to that section. Use the matching Unequip button to hang your entire current outfit back in that same section, freeing your equipment slots.\n\n<b>Take Apart:</b> Splits the wardrobe back into its Plank and Rope."
    },
