<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>CommunityModChest</RootNamespace>
        <AssemblyName>Community_Mod_Chest</AssemblyName>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <TargetFramework>net48</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DebugType>none</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>C:\Program Files (x86)\Steam\steamapps\common\Card Survival Fantasy Forest\BepInEx\plugins\Community_Mod_Chest\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="CSFFModFramework">
            <HintPath>..\HerbsAndFungi\lib\CSFFModFramework.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>..\HerbsAndFungi\lib\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>..\HerbsAndFungi\lib\Assembly-CSharp-nstrip.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>..\HerbsAndFungi\lib\BepInEx.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="DOTween">
            <HintPath>..\HerbsAndFungi\lib\DOTween.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- UnityEngine DLLs -->
        <Reference Include="UnityEngine" HintPath="..\HerbsAndFungi\lib\UnityEngine.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro" HintPath="..\HerbsAndFungi\lib\Unity.TextMeshPro.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.CoreModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.AnimationModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.AssetBundleModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AudioModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.AudioModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.ImageConversionModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.IMGUIModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.InputLegacyModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.InputModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.InputModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.JSONSerializeModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.JSONSerializeModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.TextRenderingModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.UI" HintPath="..\HerbsAndFungi\lib\UnityEngine.UI.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.UIModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.UIModule.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.VideoModule" HintPath="..\HerbsAndFungi\lib\UnityEngine.VideoModule.dll">
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <!-- Copy mod content files to output -->
    <ItemGroup>
        <Content Include="ModInfo.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="BlueprintTabs.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('BlueprintTabs.json')" />
        <Content Include="CardData\**\*.json" CopyToOutputDirectory="PreserveNewest" Link="CardData\%(RecursiveDir)%(Filename)%(Extension)" />
        <Content Include="CharacterPerk\*.json" CopyToOutputDirectory="PreserveNewest" Link="CharacterPerk\%(Filename)%(Extension)" />
        <Content Include="NPCAgent\*.json" CopyToOutputDirectory="PreserveNewest" Link="NPCAgent\%(Filename)%(Extension)" Condition="Exists('NPCAgent')" />
        <Content Include="NPCStat\*.json" CopyToOutputDirectory="PreserveNewest" Link="NPCStat\%(Filename)%(Extension)" Condition="Exists('NPCStat')" />
        <Content Include="NPCCharacterPerk\*.json" CopyToOutputDirectory="PreserveNewest" Link="NPCCharacterPerk\%(Filename)%(Extension)" Condition="Exists('NPCCharacterPerk')" />
        <Content Include="SelfTriggeredAction\*.json" CopyToOutputDirectory="PreserveNewest" Link="SelfTriggeredAction\%(Filename)%(Extension)" />
        <Content Include="GameStat\*.json" CopyToOutputDirectory="PreserveNewest" Link="GameStat\%(Filename)%(Extension)" />
        <Content Include="Localization\*.csv" CopyToOutputDirectory="PreserveNewest" Link="Localization\%(Filename)%(Extension)" />
        <Content Include="WorldMap\*.json" CopyToOutputDirectory="PreserveNewest" Link="WorldMap\%(Filename)%(Extension)" />
        <Content Include="MapMod.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('MapMod.json')" />
        <Content Include="DropInjections.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('DropInjections.json')" />
        <Content Include="InjectImprovementInto.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('InjectImprovementInto.json')" />
        <Content Include="TradingValues.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('TradingValues.json')" />
        <Content Include="ScriptableObject\**\*.json" CopyToOutputDirectory="PreserveNewest" Link="ScriptableObject\%(RecursiveDir)%(Filename)%(Extension)" />
        <Content Include="GameSourceModify\*.json" CopyToOutputDirectory="PreserveNewest" Link="GameSourceModify\%(Filename)%(Extension)" />
        <Content Include="EncounterGuards\*.json" CopyToOutputDirectory="PreserveNewest" Link="EncounterGuards\%(Filename)%(Extension)" Condition="Exists('EncounterGuards')" />
        <Content Include="Encounter\*.json" CopyToOutputDirectory="PreserveNewest" Link="Encounter\%(Filename)%(Extension)" Condition="Exists('Encounter')" />
        <!-- QuestLog/ and Objective/ are intentionally NOT shipped. The Wisp's deeds use a
             self-contained C# tracker (Deeds/) instead of vanilla QuestLogs, because vanilla
             quests serialize into the save that reconstructs blueprint research on load and
             reset it ("research progress lost", 2026-06-17). The source JSON is kept as
             reference data for deed completion conditions (tool/stat/encounter GUIDs). -->
        <Content Include="Resource\**\*.*" CopyToOutputDirectory="PreserveNewest" Link="Resource\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
