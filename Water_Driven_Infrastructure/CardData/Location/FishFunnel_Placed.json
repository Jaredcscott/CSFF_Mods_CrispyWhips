{
  "UniqueID": "water_sawmill_fish_funnel_placed",
  "CardName": {
    "ParentObjectID": "water_sawmill_fish_funnel_placed",
    "LocalizationKey": "Water_Sawmill_FishFunnelPlaced_CardName",
    "DefaultText": "Fish Funnel"
  },
  "CardDescription": {
    "ParentObjectID": "water_sawmill_fish_funnel_placed",
    "LocalizationKey": "Water_Sawmill_FishFunnelPlaced_CardDescription",
    "DefaultText": "A woven timber wing-wall staked out across the current. It steers passing fish toward any funnel trap set in the same water."
  },
  "CardHelpSection": {
    "ParentObjectID": "water_sawmill_fish_funnel_placed",
    "LocalizationKey": "Water_Sawmill_FishFunnelPlaced_CardHelpSection",
    "DefaultText": "<b>Effect:</b> A Funnel Trap in the same location gains fish twice as fast (+10 population per time point on top of its own 10). The funnel does nothing on its own, so set a Funnel Trap here as well. <b>Pack Up:</b> Recover the funnel as a portable kit."
  },
