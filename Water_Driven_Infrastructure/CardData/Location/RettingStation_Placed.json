{
  "UniqueID": "water_sawmill_retting_station_placed",
  "CardName": {
    "ParentObjectID": "water_sawmill_retting_station_placed",
    "LocalizationKey": "Water_Sawmill_RettingStationPlaced_CardName",
    "DefaultText": "Retting Pit"
  },
  "CardDescription": {
    "ParentObjectID": "water_sawmill_retting_station_placed",
    "LocalizationKey": "Water_Sawmill_RettingStationPlaced_CardDescription",
    "DefaultText": "A stone-lined pit kept full by running water. Flax, nettle and reeds soak in it just as they would in a river."
  },
  "CardHelpSection": {
    "ParentObjectID": "water_sawmill_retting_station_placed",
    "LocalizationKey": "Water_Sawmill_RettingStationPlaced_CardHelpSection",
    "DefaultText": "<b>Placement:</b> Build it at a river or lake, or at any outdoor location watered by a connected Mill Race Outlet. Anywhere else the build is refused. The pit takes no stems while that water is cut off (a closed or missing outlet, or a frozen one with no fire beside it).\n\n<b>Soaking:</b> Drag Flax Stems, Nettle Stems or Fresh Reeds onto the pit. They become the same Soaking cards a river makes and gain quality exactly as they would in a river: no faster, and to the same limits (flax 40, reeds 50, nettle 30). Pick them up when they are ready. Nothing else can be soaked here.\n\n<b>Pack Up:</b> Packs the pit back into its kit."
  },
