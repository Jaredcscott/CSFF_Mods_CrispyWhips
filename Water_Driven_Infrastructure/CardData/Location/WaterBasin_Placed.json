    "ParentObjectID": "water_sawmill_water_basin_placed",
    "LocalizationKey": "Water_Sawmill_WaterBasin_CardDescription",
    "DefaultText": "A low stone basin fed by a thin stream from a short wooden trough. Sitting beside running water is calming."
  },
  "CardHelpSection": {
    "ParentObjectID": "water_sawmill_water_basin_placed",
    "LocalizationKey": "Water_Sawmill_WaterBasin_CardHelpSection",
