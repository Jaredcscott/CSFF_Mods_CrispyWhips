{
  "UniqueID": "water_sawmill_overshot_wheel",
  "CardName": {
    "ParentObjectID": "water_sawmill_overshot_wheel",
    "LocalizationKey": "Water_Sawmill_OvershotWheel_CardName",
    "DefaultText": "Overshot Wheel"
  },
  "CardDescription": {
    "ParentObjectID": "water_sawmill_overshot_wheel",
    "LocalizationKey": "Water_Sawmill_OvershotWheel_CardDescription",
    "DefaultText": "A water wheel fed from above, geared for speed. Fit it to a Water-Driven Sawmill, Grinding Mill, Workshop or Ore Sluice to shorten its batch action."
  },
  "CanBeRenamed": false,
  "CardHelpSection": {
    "ParentObjectID": "water_sawmill_overshot_wheel",
    "LocalizationKey": "Water_Sawmill_OvershotWheel_CardHelpSection",
    "DefaultText": "<b>Fit:</b> Drag it onto a Water-Driven Sawmill, Grinding Mill, Workshop or Ore Sluice (30 minutes). Saw All then takes 1.5 hours instead of 3, Grind All and Hammer All 15 minutes instead of 30, and Sluice All 15 minutes instead of 45, when you run them yourself (a Partner's duty work takes no time either way). One wheel per station; Pack Up (Overshot) gives it back.\n\n<b>Forge:</b> The Water-Driven Forge has no batch action to shorten, so it takes no wheel."
  },
