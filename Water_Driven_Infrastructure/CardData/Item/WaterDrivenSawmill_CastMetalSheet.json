  },
  "CardDescription": {
    "ParentObjectID": "water_sawmill_cast_metal_sheet",
    "LocalizationKey": "Water_Sawmill_CastMetalSheet_CardDescription",
    "DefaultText": "A Cast Copper Sheet from before Water-Driven Infrastructure switched to the shared Metal Sheet of CSFFModFramework. Within a quarter of an hour it becomes a Copper Sheet (a Metal Sheet of copper, Metal Type 100) by itself; Reforge as Metal Sheet does it at once. Nothing makes this card any more."
  },
  "CardHelpSection": {
    "ParentObjectID": "water_sawmill_cast_metal_sheet",
    "LocalizationKey": "Water_Sawmill_CastMetalSheet_CardHelpSection",
    "DefaultText": "<b>Retired:</b> Water-Driven Infrastructure no longer makes its own Cast Copper Sheet. Every WDI recipe now takes the shared Metal Sheet, the one CSFFModFramework ships for all mods. This old card turns into a Copper Sheet (a Metal Sheet of copper, Metal Type 100) by itself within a quarter of an hour, or at once with Reforge as Metal Sheet."
  },
